# HEMSight – startup values for Docker Compose.
#
# Copy this once before the first start:  cp .env.example .env
#
# Your configuration does not live here. Home Assistant, tariffs, devices and credentials
# are set up later in the app itself; it stores them in data/config.yaml, with passwords
# and tokens encrypted in data/secrets.yaml. This file only says which version runs and
# on which ports.

# --- Version ---
# A fixed version, so updating stays a deliberate step: change the number, then run
# "docker compose pull && docker compose up -d". Putting "latest" here gets you the newest
# release on every pull – rarely what you want while this is a beta.
HEMSIGHT_VERSION=0.0.5-alpha

# --- The one value you should really set ---
# Decrypts data/secrets.yaml and signs your logins. Generate it locally, for example with:
#   openssl rand -base64 32
# Leaving it empty is fine: HEMSight then creates data/.secret.key on first start. That
# file must go into your backup, otherwise secrets.yaml is worthless.
HEMSIGHT_SECRET_KEY=

# --- Ports, only needed if the defaults are already taken ---
# HEMSIGHT_FRONTEND_PORT=18081     # the app in your browser
# HEMSIGHT_BACKEND_PORT=18080      # the service behind it, bound to 127.0.0.1 only
# HEMSIGHT_OCPP_PORT=9000          # wallboxes connecting over OCPP
# HEMSIGHT_EEBUS_PORT=4712         # only in use with "--profile eebus"
# HEMSIGHT_STACK_PREFIX=hemsight   # container and network name, needed for several stacks
